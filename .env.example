# Copy to .env and fill in. Never commit .env.

# Comma-separated "<appId>:<key>" pairs; keys must be at least 24 characters.
# Generate a key: openssl rand -hex 24
API_KEYS=printer:CHANGE_ME_printer_key_000000000000,pdfreader:CHANGE_ME_reader_key_00000000000

# Keeps POST /convert_to_pdf (no key) alive for app builds released before /v2. Turn off once old builds are gone.
LEGACY_ENDPOINT_ENABLED=true

# Optional bearer token for GET /metrics. Empty = open (only safe if /metrics is not exposed publicly).
METRICS_TOKEN=

# Set to the reverse proxy address (e.g. 10.0.0.0/8) or true when running behind Nginx/Cloudflare,
# otherwise rate limiting sees the proxy IP instead of the client IP.
TRUST_PROXY=false

LOG_LEVEL=info

MAX_FILE_BYTES=20971520
GOTENBERG_TIMEOUT_MS=60000
WORKER_CONCURRENCY=2
QUEUE_MAX_PENDING=50
SYNC_WAIT_MS=90000
RESULT_TTL_SECONDS=3600

RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_POLL_MAX=240
RATE_LIMIT_WINDOW_MS=60000
CACHE_ENABLED=true
XLSX_PRINT_FIXES=true
