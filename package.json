{
  "name": "print-convert-service",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "tsx scripts/make-samples.ts"
  },
  "license": "UNLICENSED",
  "description": "Office to PDF conversion gateway in front of Gotenberg",
  "dependencies": {
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "prom-client": "^15.1.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
